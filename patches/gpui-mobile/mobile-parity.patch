+use accesskit::{ActionHandler, ActionRequest, ActivationHandler, TreeUpdate};
+use accesskit_android::{jni, Adapter, PlatformAction, QueuedEvents};
+use gpui::A11yCallbacks;
+use jni::{
+    objects::{GlobalRef, JClass, JObject},
+    sys::{jboolean, jfloat, jint, jlong, JNI_FALSE, JNI_TRUE},
+    JNIEnv, NativeMethod,
+};
+use std::{
+    collections::BTreeMap,
+    ffi::c_void,
+    sync::{
+        atomic::{AtomicI64, Ordering},
+        Arc, Mutex, OnceLock, Weak,
+    },
+};
+
+struct Activate(Box<dyn Fn() -> Option<TreeUpdate> + Send>);
+impl ActivationHandler for Activate {
+    fn request_initial_tree(&mut self) -> Option<TreeUpdate> {
+        (self.0)()
+    }
+}
+struct Actions(Box<dyn Fn(ActionRequest) + Send>);
+impl ActionHandler for Actions {
+    fn do_action(&mut self, request: ActionRequest) {
+        (self.0)(request);
+    }
+}
+struct State {
+    adapter: Adapter,
+    activation: Activate,
+    actions: Actions,
+}
+static NEXT: AtomicI64 = AtomicI64::new(1);
+static STATES: Mutex<Option<BTreeMap<i64, Weak<Mutex<State>>>>> = Mutex::new(None);
+static CALLBACKS: Mutex<
+    Option<BTreeMap<i64, (i64, Box<dyn FnOnce(&mut JNIEnv, &JObject) + Send>)>>,
+> = Mutex::new(None);
+static CLASS: OnceLock<GlobalRef> = OnceLock::new();
+fn state(id: jlong) -> Option<Arc<Mutex<State>>> {
+    STATES
+        .lock()
+        .unwrap()
+        .as_ref()?
+        .get(&id)
+        .and_then(Weak::upgrade)
+}
+fn raise(env: &mut JNIEnv, host: &JObject, events: Option<QueuedEvents>) {
+    if let Some(events) = events {
+        events.raise(env, host);
+    }
+}
+
+extern "system" fn create_node<'a>(
+    mut env: JNIEnv<'a>,
+    _: JClass<'a>,
+    id: jlong,
+    host: JObject<'a>,
+    virtual_id: jint,
+) -> JObject<'a> {
+    let Some(s) = state(id) else {
+        return JObject::null();
+    };
+    let mut s = s.lock().unwrap();
+    let State {
+        adapter,
+        activation,
+        ..
+    } = &mut *s;
+    adapter.create_accessibility_node_info(activation, &mut env, &host, virtual_id)
+}
+extern "system" fn find_focus<'a>(
+    mut env: JNIEnv<'a>,
+    _: JClass<'a>,
+    id: jlong,
+    host: JObject<'a>,
+    focus: jint,
+) -> JObject<'a> {
+    let Some(s) = state(id) else {
+        return JObject::null();
+    };
+    let mut s = s.lock().unwrap();
+    let State {
+        adapter,
+        activation,
+        ..
+    } = &mut *s;
+    adapter.find_focus(activation, &mut env, &host, focus)
+}
+extern "system" fn perform_action(
+    mut env: JNIEnv,
+    _: JClass,
+    id: jlong,
+    host: JObject,
+    virtual_id: jint,
+    action: jint,
+    args: JObject,
+) -> jboolean {
+    let Some(action) = PlatformAction::from_java(&mut env, action, &args) else {
+        return JNI_FALSE;
+    };
+    let Some(s) = state(id) else { return JNI_FALSE };
+    let events = {
+        let mut state = s.lock().unwrap();
+        let State {
+            adapter, actions, ..
+        } = &mut *state;
+        adapter.perform_action(actions, virtual_id, &action)
+    };
+    let Some(events) = events else {
+        return JNI_FALSE;
+    };
+    raise(&mut env, &host, Some(events));
+    JNI_TRUE
+}
+extern "system" fn hover(
+    mut env: JNIEnv,
+    _: JClass,
+    id: jlong,
+    host: JObject,
+    action: jint,
+    x: jfloat,
+    y: jfloat,
+) -> jboolean {
+    let Some(s) = state(id) else { return JNI_FALSE };
+    let events = {
+        let mut s = s.lock().unwrap();
+        let State {
+            adapter,
+            activation,
+            ..
+        } = &mut *s;
+        adapter.on_hover_event(activation, action, x, y)
+    };
+    if events.is_none() {
+        return JNI_FALSE;
+    }
+    raise(&mut env, &host, events);
+    JNI_TRUE
+}
+extern "system" fn run_callback(mut env: JNIEnv, _: JClass, host: JObject, callback_id: jlong) {
+    let callback = CALLBACKS
+        .lock()
+        .unwrap()
+        .as_mut()
+        .and_then(|m| m.remove(&callback_id));
+    if let Some((owner, callback)) = callback {
+        if state(owner).is_some() {
+            callback(&mut env, &host);
+        }
+    }
+}
+
+fn helper(env: &mut JNIEnv, activity: &JObject) -> Result<GlobalRef, String> {
+    if let Some(class) = CLASS.get() {
+        return Ok(class.clone());
+    }
+    let loader = env
+        .call_method(activity, "getClassLoader", "()Ljava/lang/ClassLoader;", &[])
+        .and_then(|v| v.l())
+        .map_err(|e| e.to_string())?;
+    let name = env
+        .new_string("dev.gpui.mobile.GpuiAccessibility")
+        .map_err(|e| e.to_string())?;
+    let cls = env
+        .call_method(
+            loader,
+            "loadClass",
+            "(Ljava/lang/String;)Ljava/lang/Class;",
+            &[(&name).into()],
+        )
+        .and_then(|v| v.l())
+        .map_err(|e| e.to_string())?;
+    let class = JClass::from(cls);
+    env.register_native_methods(
+        &class,
+        &[
+            NativeMethod {
+                name: "createNode".into(),
+                sig: "(JLandroid/view/View;I)Landroid/view/accessibility/AccessibilityNodeInfo;"
+                    .into(),
+                fn_ptr: create_node as *mut c_void,
+            },
+            NativeMethod {
+                name: "findFocus".into(),
+                sig: "(JLandroid/view/View;I)Landroid/view/accessibility/AccessibilityNodeInfo;"
+                    .into(),
+                fn_ptr: find_focus as *mut c_void,
+            },
+            NativeMethod {
+                name: "performAction".into(),
+                sig: "(JLandroid/view/View;IILandroid/os/Bundle;)Z".into(),
+                fn_ptr: perform_action as *mut c_void,
+            },
+            NativeMethod {
+                name: "hover".into(),
+                sig: "(JLandroid/view/View;IFF)Z".into(),
+                fn_ptr: hover as *mut c_void,
+            },
+            NativeMethod {
+                name: "runCallback".into(),
+                sig: "(Landroid/view/View;J)V".into(),
+                fn_ptr: run_callback as *mut c_void,
+            },
+        ],
+    )
+    .map_err(|e| e.to_string())?;
+    let global = env.new_global_ref(class).map_err(|e| e.to_string())?;
+    let _ = CLASS.set(global.clone());
+    Ok(global)
+}
+
+pub(super) struct Accessibility {
+    vm: jni::JavaVM,
+    class: GlobalRef,
+    host: jni::objects::WeakRef,
+    id: i64,
+    state: Arc<Mutex<State>>,
+    deactivate: Box<dyn Fn() + Send>,
+}
+impl Accessibility {
+    pub(super) fn new(callbacks: A11yCallbacks) -> Result<Self, String> {
+        let vm = unsafe { jni::JavaVM::from_raw(super::jni::java_vm().cast()) }
+            .map_err(|e| e.to_string())?;
+        let mut env = vm.attach_current_thread().map_err(|e| e.to_string())?;
+        let raw = super::jni::activity_as_ptr();
+        if raw.is_null() {
+            return Err("Activity unavailable during accessibility initialization".into());
+        }
+        // activity_as_ptr is borrowed (often a global JNI ref); do not let a
+        // JObject wrapper delete the borrowed handle when this scope ends.
+        let activity_borrowed =
+            std::mem::ManuallyDrop::new(unsafe { JObject::from_raw(raw.cast()) });
+        let activity = env
+            .new_local_ref(&*activity_borrowed)
+            .map_err(|e| e.to_string())?;
+        let host = env
+            .call_method(
+                &activity,
+                "findViewById",
+                "(I)Landroid/view/View;",
+                &[16908290.into()],
+            )
+            .and_then(|v| v.l())
+            .map_err(|e| e.to_string())?;
+        if host.is_null() {
+            return Err("Android content view unavailable".into());
+        }
+        let class = helper(&mut env, &activity)?;
+        let id = NEXT.fetch_add(1, Ordering::Relaxed);
+        let state = Arc::new(Mutex::new(State {
+            adapter: Adapter::default(),
+            activation: Activate(callbacks.activation),
+            actions: Actions(callbacks.action),
+        }));
+        STATES
+            .lock()
+            .unwrap()
+            .get_or_insert_with(BTreeMap::new)
+            .insert(id, Arc::downgrade(&state));
+        let class_local = JClass::from(
+            env.new_local_ref(class.as_obj())
+                .map_err(|e| e.to_string())?,
+        );
+        env.call_static_method(
+            &class_local,
+            "install",
+            "(Landroid/view/View;J)V",
+            &[(&host).into(), id.into()],
+        )
+        .map_err(|e| e.to_string())?;
+        let host = env
+            .new_weak_ref(&host)
+            .map_err(|e| e.to_string())?
+            .ok_or("Unable to retain Android host")?;
+        drop(env);
+        Ok(Self {
+            vm,
+            class,
+            host,
+            id,
+            state,
+            deactivate: callbacks.deactivation,
+        })
+    }
+    pub(super) fn update(&mut self, update: TreeUpdate) {
+        let events = self
+            .state
+            .lock()
+            .unwrap()
+            .adapter
+            .update_if_active(|| update);
+        let Some(events) = events else { return };
+        let Ok(mut env) = self.vm.attach_current_thread() else {
+            return;
+        };
+        let Ok(Some(host)) = self.host.upgrade_local(&env) else {
+            return;
+        };
+        let callback_id = NEXT.fetch_add(1, Ordering::Relaxed);
+        CALLBACKS
+            .lock()
+            .unwrap()
+            .get_or_insert_with(BTreeMap::new)
+            .insert(
+                callback_id,
+                (self.id, Box::new(move |env, host| events.raise(env, host))),
+            );
+        let posted = env.new_local_ref(self.class.as_obj()).and_then(|class| {
+            env.call_static_method(
+                JClass::from(class),
+                "postCallback",
+                "(Landroid/view/View;J)Z",
+                &[(&host).into(), callback_id.into()],
+            )?
+            .z()
+        });
+        if !matches!(posted, Ok(true)) {
+            let _ = env.exception_clear();
+            if let Some(map) = CALLBACKS.lock().unwrap().as_mut() {
+                map.remove(&callback_id);
+            }
+        }
+    }
+}
+impl Drop for Accessibility {
+    fn drop(&mut self) {
+        if let Ok(mut env) = self.vm.attach_current_thread() {
+            if let Ok(Some(host)) = self.host.upgrade_local(&env) {
+                if let Ok(class_local) = env.new_local_ref(self.class.as_obj()) {
+                    let class_local = JClass::from(class_local);
+                    let _ = env.call_static_method(
+                        &class_local,
+                        "uninstall",
+                        "(Landroid/view/View;J)V",
+                        &[(&host).into(), self.id.into()],
+                    );
+                }
+            }
+        }
+        if let Some(map) = STATES.lock().unwrap().as_mut() {
+            map.remove(&self.id);
+        }
+        if let Some(map) = CALLBACKS.lock().unwrap().as_mut() {
+            map.retain(|_, (owner, _)| *owner != self.id);
+        }
+        (self.deactivate)();
+    }
+}
