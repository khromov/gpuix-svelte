+//! UIKit presentation for GPUI's AccessKit tree.
+//!
+//! GPUI owns the semantic tree and action routing. UIKit elements are retained
+//! per GPUI window and updated in place so VoiceOver focus remains stable.
+
+use accesskit::{Action, ActionRequest, Node, NodeId, TreeId, TreeUpdate};
+use objc2::runtime::{AnyClass, AnyObject, ClassBuilder, Sel};
+use objc2::{class, msg_send, sel};
+use parking_lot::Mutex;
+use std::{
+    collections::{HashMap, HashSet},
+    ffi::CStr,
+    sync::{Arc, Mutex as StdMutex, Once, OnceLock, Weak},
+};
+
+static ELEMENT_CLASS: Once = Once::new();
+static WINDOWS: OnceLock<StdMutex<HashMap<usize, Weak<Mutex<AccessibilityState>>>>> =
+    OnceLock::new();
+
+fn windows() -> &'static StdMutex<HashMap<usize, Weak<Mutex<AccessibilityState>>>> {
+    WINDOWS.get_or_init(|| StdMutex::new(HashMap::new()))
+}
+
+#[derive(Default)]
+struct A11yTreeState {
+    nodes: HashMap<NodeId, Node>,
+    root: Option<NodeId>,
+    tree_id: Option<TreeId>,
+}
+
+impl A11yTreeState {
+    fn apply(&mut self, update: TreeUpdate) -> HashMap<NodeId, Node> {
+        self.tree_id = Some(update.tree_id);
+        if let Some(tree) = update.tree {
+            self.root = Some(tree.root);
+        }
+        for (id, node) in update.nodes {
+            self.nodes.insert(id, node);
+        }
+        let Some(root) = self.root else {
+            return HashMap::new();
+        };
+        let mut reachable = HashMap::new();
+        let mut stack = vec![root];
+        while let Some(id) = stack.pop() {
+            if reachable.contains_key(&id) {
+                continue;
+            }
+            if let Some(node) = self.nodes.get(&id) {
+                reachable.insert(id, node.clone());
+                stack.extend(node.children().iter().rev().copied());
+            }
+        }
+        self.nodes = reachable.clone();
+        reachable
+    }
+}
+
+pub(super) struct AccessibilityState {
+    tree: A11yTreeState,
+    elements: HashMap<NodeId, *mut AnyObject>,
+    action: Option<Arc<Mutex<Box<dyn Fn(ActionRequest) + Send>>>>,
+}
+
+impl Default for AccessibilityState {
+    fn default() -> Self {
+        Self {
+            tree: A11yTreeState::default(),
+            elements: HashMap::new(),
+            action: None,
+        }
+    }
+}
+
+impl Drop for AccessibilityState {
+    fn drop(&mut self) {
+        unsafe {
+            for element in self.elements.drain().map(|(_, element)| element) {
+                if !element.is_null() {
+                    let _: () = msg_send![element, release];
+                }
+            }
+        }
+    }
+}
+
+unsafe impl Send for AccessibilityState {}
+
+fn send_action(this: *mut AnyObject, action: Action) -> bool {
+    unsafe {
+        let container: *mut AnyObject = msg_send![this, accessibilityContainer];
+        if container.is_null() {
+            return false;
+        }
+        let state = windows()
+            .lock()
+            .unwrap()
+            .get(&(container as usize))
+            .and_then(Weak::upgrade);
+        let Some(state) = state else {
+            return false;
+        };
+        let identifier: *mut AnyObject = msg_send![this, accessibilityIdentifier];
+        if identifier.is_null() {
+            return false;
+        }
+        let utf8: *const std::ffi::c_char = msg_send![identifier, UTF8String];
+        if utf8.is_null() {
+            return false;
+        }
+        let key = CStr::from_ptr(utf8).to_string_lossy();
+        let Ok(target_node) = key.parse::<u64>() else {
+            return false;
+        };
+        let state = state.lock();
+        let target_node = NodeId(target_node);
+        let Some(node) = state.tree.nodes.get(&target_node) else {
+            return false;
+        };
+        let activate_input = action == Action::Click
+            && matches!(node.role(), accesskit::Role::TextInput | accesskit::Role::MultilineTextInput | accesskit::Role::SearchInput)
+            && node.supports_action(Action::Focus);
+        if !node.supports_action(action) && !activate_input {
+            return false;
+        }
+        let tree_id = state.tree.tree_id.unwrap_or(TreeId::ROOT);
+        let callback = state.action.clone();
+        drop(state);
+        if let Some(callback) = callback {
+            (callback.lock())(ActionRequest {
+                action,
+                target_tree: tree_id,
+                target_node,
+                data: None,
+            });
+            true
+        } else {
+            false
+        }
+    }
+}
+
+extern "C" fn accessibility_activate(this: *mut AnyObject, _cmd: Sel) -> objc2::runtime::Bool {
+    if send_action(this, Action::Click) {
+        return true.into();
+    }
+    send_action(this, Action::Focus).into()
+}
+
+extern "C" fn accessibility_did_become_focused(this: *mut AnyObject, _cmd: Sel) {
+    send_action(this, Action::Focus);
+}
+
+extern "C" fn accessibility_increment(this: *mut AnyObject, _cmd: Sel) {
+    send_action(this, Action::Increment);
+}
+
+extern "C" fn accessibility_decrement(this: *mut AnyObject, _cmd: Sel) {
+    send_action(this, Action::Decrement);
+}
+
+fn element_class() -> &'static AnyClass {
+    ELEMENT_CLASS.call_once(|| unsafe {
+        let mut decl =
+            ClassBuilder::new(c"GPUIXAccessibilityElement", class!(UIAccessibilityElement))
+                .unwrap();
+        decl.add_method(
+            sel!(accessibilityActivate),
+            accessibility_activate as extern "C" fn(*mut AnyObject, Sel) -> objc2::runtime::Bool,
+        );
+        decl.add_method(
+            sel!(accessibilityElementDidBecomeFocused),
+            accessibility_did_become_focused as extern "C" fn(*mut AnyObject, Sel),
+        );
+        decl.add_method(
+            sel!(accessibilityIncrement),
+            accessibility_increment as extern "C" fn(*mut AnyObject, Sel),
+        );
+        decl.add_method(
+            sel!(accessibilityDecrement),
+            accessibility_decrement as extern "C" fn(*mut AnyObject, Sel),
+        );
+        decl.register();
+    });
+    class!(GPUIXAccessibilityElement)
+}
+
+/// Per-window UIKit accessibility adapter state.
+pub(super) type IosAccessibilityState = Arc<Mutex<AccessibilityState>>;
+
+pub(super) fn new_state() -> IosAccessibilityState {
+    Arc::new(Mutex::new(AccessibilityState::default()))
+}
+
+/// Initialize GPUI accessibility callbacks and attach a per-window state to its UIView.
+pub(super) fn initialize(
+    view: *mut AnyObject,
+    state: &IosAccessibilityState,
+    activation: Box<dyn Fn() -> Option<TreeUpdate> + Send>,
+    action: Box<dyn Fn(ActionRequest) + Send>,
+    scale: f32,
+) {
+    state.lock().action = Some(Arc::new(Mutex::new(action)));
+    windows()
+        .lock()
+        .unwrap()
+        .insert(view as usize, Arc::downgrade(state));
+    if let Some(update) = activation() {
+        update_tree(view, state, update, scale);
+    }
+}
+
+/// Notify UIKit that the accessible frame geometry changed.
+pub(super) fn notify_layout_changed(_view: *mut AnyObject) {
+    unsafe {
+        UIAccessibilityPostNotification(
+            UIAccessibilityLayoutChangedNotification,
+            std::ptr::null_mut(),
+        );
+    }
+}
+
+/// Remove this view's callback route; its retained elements are released with its state.
+pub(super) fn deinitialize(view: *mut AnyObject) {
+    windows().lock().unwrap().remove(&(view as usize));
+    unsafe {
+        let _: () = msg_send![view, setAccessibilityElements: std::ptr::null_mut::<AnyObject>()];
+    }
+}
+
+/// Apply an AccessKit update, retaining elements by node ID and mutating them in place.
+pub(super) fn update_tree(
+    view: *mut AnyObject,
+    state: &IosAccessibilityState,
+    update: TreeUpdate,
+    scale: f32,
+) {
+    let mut state = state.lock();
+    let prior_nodes = state.tree.nodes.clone();
+    let nodes = state.tree.apply(update);
+    let changed = prior_nodes != nodes;
+    if !changed {
+        return;
+    }
+    let Some(root) = state.tree.root else {
+        return;
+    };
+
+    let (ordered, consumed_text) = visible_nodes(&nodes, root);
+    let ordered_ids: HashSet<_> = ordered.iter().map(|(id, _, _)| *id).collect();
+    let removed: Vec<_> = state
+        .elements
+        .keys()
+        .filter(|id| !ordered_ids.contains(id))
+        .copied()
+        .collect();
+
+    unsafe {
+        let array: *mut AnyObject = msg_send![class!(NSMutableArray), array];
+        let scale = scale.max(0.01) as f64;
+        for (id, node, synthesized_label) in &ordered {
+            let element = if let Some(element) = state.elements.get(id) {
+                *element
+            } else {
+                let element: *mut AnyObject = msg_send![element_class(), alloc];
+                let element: *mut AnyObject =
+                    msg_send![element, initWithAccessibilityContainer: view];
+                let identifier = std::ffi::CString::new(id.0.to_string()).unwrap();
+                let ns_id: *mut AnyObject =
+                    msg_send![class!(NSString), stringWithUTF8String: identifier.as_ptr()];
+                let _: () = msg_send![element, setAccessibilityIdentifier: ns_id];
+                state.elements.insert(*id, element);
+                element
+            };
+
+            let label = node.label().or(synthesized_label.as_deref());
+            set_string(element, 0, label);
+            set_string(element, 1, node.value().or_else(|| toggled_value(node)));
+            set_string(element, 2, node.description());
+            if let Some(bounds) = node.bounds() {
+                let rect = super::cg_types::ObjcCGRect::new(
+                    bounds.min_x() / scale,
+                    bounds.min_y() / scale,
+                    bounds.width() / scale,
+                    bounds.height() / scale,
+                );
+                let _: () = msg_send![element, setAccessibilityFrameInContainerSpace: rect];
+                let screen_rect = UIAccessibilityConvertFrameToScreenCoordinates(rect, view);
+                let _: () = msg_send![element, setAccessibilityFrame: screen_rect];
+            } else {
+                let _: () = msg_send![element, setAccessibilityFrameInContainerSpace: super::cg_types::ObjcCGRect::default()];
+            }
+            let _: () = msg_send![element, setIsAccessibilityElement: true];
+            let traits = role_traits(node);
+            let _: () = msg_send![element, setAccessibilityTraits: traits];
+            let _: () = msg_send![array, addObject: element];
+        }
+
+        // Updating the explicit list excludes the hidden UITextInputView proxy from
+        // VoiceOver traversal; GPUI's corresponding AccessKit input node remains exposed.
+        let _: () = msg_send![view, setAccessibilityElements: array];
+        let _: () = msg_send![view, setIsAccessibilityElement: false];
+
+        for id in removed {
+            if let Some(element) = state.elements.remove(&id) {
+                let _: () = msg_send![element, release];
+            }
+        }
+
+        // UIKit's notification is a C function, not a UIAccessibility class method.
+        if changed {
+            UIAccessibilityPostNotification(
+                UIAccessibilityLayoutChangedNotification,
+                std::ptr::null_mut(),
+            );
+        }
+    }
+    let _ = consumed_text;
+}
+
+unsafe fn set_string(element: *mut AnyObject, property: u8, value: Option<&str>) {
+    let ns_value = value.map(|value| {
+        let value = std::ffi::CString::new(value).unwrap_or_default();
+        let ns: *mut AnyObject = msg_send![class!(NSString), stringWithUTF8String: value.as_ptr()];
+        ns
+    });
+    let value = ns_value.unwrap_or(std::ptr::null_mut());
+    match property {
+        0 => {
+            let _: () = msg_send![element, setAccessibilityLabel: value];
+        }
+        1 => {
+            let _: () = msg_send![element, setAccessibilityValue: value];
+        }
+        _ => {
+            let _: () = msg_send![element, setAccessibilityHint: value];
+        }
+    }
+}
+
+fn toggled_value(node: &Node) -> Option<&'static str> {
+    match node.toggled() {
+        Some(accesskit::Toggled::False) => Some("Off"),
+        Some(accesskit::Toggled::True) => Some("On"),
+        Some(accesskit::Toggled::Mixed) => Some("Mixed"),
+        None => None,
+    }
+}
+
+fn role_traits(node: &Node) -> u64 {
+    unsafe {
+        let mut traits: u64 = match node.role() {
+            accesskit::Role::Button
+            | accesskit::Role::DefaultButton
+            | accesskit::Role::CheckBox
+            | accesskit::Role::RadioButton
+            | accesskit::Role::Switch
+            | accesskit::Role::MenuItem
+            | accesskit::Role::Tab
+            | accesskit::Role::DisclosureTriangle => UIAccessibilityTraitButton,
+            accesskit::Role::Link => UIAccessibilityTraitLink,
+            accesskit::Role::Image => UIAccessibilityTraitImage,
+            accesskit::Role::Label | accesskit::Role::TextRun | accesskit::Role::Paragraph => {
+                UIAccessibilityTraitStaticText
+            }
+            accesskit::Role::Heading
+            | accesskit::Role::Header
+            | accesskit::Role::RowHeader
+            | accesskit::Role::ColumnHeader => UIAccessibilityTraitHeader,
+            accesskit::Role::SearchInput | accesskit::Role::Search => {
+                UIAccessibilityTraitSearchField
+            }
+            accesskit::Role::Slider | accesskit::Role::SpinButton => UIAccessibilityTraitAdjustable,
+            _ => 0,
+        };
+        if node.is_disabled() {
+            traits |= UIAccessibilityTraitNotEnabled;
+        }
+        if node.is_selected().unwrap_or(false) {
+            traits |= UIAccessibilityTraitSelected;
+        }
+        traits
+    }
+}
+
+fn visible_nodes(
+    nodes: &HashMap<NodeId, Node>,
+    root: NodeId,
+) -> (Vec<(NodeId, Node, Option<String>)>, HashSet<NodeId>) {
+    let mut output = Vec::new();
+    let mut consumed_text = HashSet::new();
+    let mut stack = vec![root];
+    while let Some(id) = stack.pop() {
+        let Some(node) = nodes.get(&id) else {
+            continue;
+        };
+        if node.is_hidden() {
+            continue;
+        }
+        let synthesized = if id != root && can_have_synthesized_label(node.role()) {
+            let mut text = Vec::new();
+            collect_text(nodes, id, &mut text, &mut consumed_text);
+            if node.label().is_none() {
+                let label = text.join(" ");
+                (!label.is_empty()).then_some(label)
+            } else {
+                None
+            }
+        } else {
+            None
+        };
+        let meaningful = node.label().is_some()
+            || node.value().is_some()
+            || synthesized.is_some()
+            || node.supports_action(Action::Click)
+            || node.supports_action(Action::Focus)
+            || node.supports_action(Action::Increment)
+            || node.supports_action(Action::Decrement);
+        if id != root && meaningful && !consumed_text.contains(&id) {
+            output.push((id, node.clone(), synthesized));
+        }
+        stack.extend(node.children().iter().rev().copied());
+    }
+    (output, consumed_text)
+}
+
+fn can_have_synthesized_label(role: accesskit::Role) -> bool {
+    matches!(
+        role,
+        accesskit::Role::Label
+            | accesskit::Role::Paragraph
+            | accesskit::Role::Button
+            | accesskit::Role::DefaultButton
+            | accesskit::Role::CheckBox
+            | accesskit::Role::RadioButton
+            | accesskit::Role::Switch
+            | accesskit::Role::Link
+            | accesskit::Role::MenuItem
+            | accesskit::Role::Tab
+    )
+}
+
+fn collect_text(
+    nodes: &HashMap<NodeId, Node>,
+    parent: NodeId,
+    text: &mut Vec<String>,
+    consumed: &mut HashSet<NodeId>,
+) {
+    let Some(node) = nodes.get(&parent) else {
+        return;
+    };
+    for child_id in node.children() {
+        let Some(child) = nodes.get(child_id) else {
+            continue;
+        };
+        if child.is_hidden()
+            || child.supports_action(Action::Click)
+            || child.supports_action(Action::Focus)
+            || child.supports_action(Action::Increment)
+            || child.supports_action(Action::Decrement)
+        {
+            continue;
+        }
+        if let Some(value) = child.value().or(child.label()) {
+            if matches!(
+                child.role(),
+                accesskit::Role::TextRun | accesskit::Role::Label
+            ) {
+                text.push(value.to_owned());
+                consumed.insert(*child_id);
+                continue;
+            }
+        }
+        collect_text(nodes, *child_id, text, consumed);
+    }
+}
+
+#[link(name = "UIKit", kind = "framework")]
+unsafe extern "C" {
+    fn UIAccessibilityConvertFrameToScreenCoordinates(
+        rect: super::cg_types::ObjcCGRect,
+        view: *mut AnyObject,
+    ) -> super::cg_types::ObjcCGRect;
+    static UIAccessibilityTraitButton: u64;
+    static UIAccessibilityTraitLink: u64;
+    static UIAccessibilityTraitImage: u64;
+    static UIAccessibilityTraitStaticText: u64;
+    static UIAccessibilityTraitHeader: u64;
+    static UIAccessibilityTraitSearchField: u64;
+    static UIAccessibilityTraitAdjustable: u64;
+    static UIAccessibilityTraitNotEnabled: u64;
+    static UIAccessibilityTraitSelected: u64;
+    static UIAccessibilityLayoutChangedNotification: u32;
+    fn UIAccessibilityPostNotification(notification: u32, argument: *mut AnyObject);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use accesskit::{Role, Tree};
+
+    #[test]
+    fn tree_deltas_prune_removed_nodes_and_actions_follow_node_support() {
+        let parent = NodeId(1);
+        let child = NodeId(2);
+        let mut root = Node::new(Role::Window);
+        root.set_children(vec![child]);
+        let mut button = Node::new(Role::Button);
+        button.set_label("Run");
+        button.add_action(Action::Click);
+        let mut state = A11yTreeState::default();
+        let first = state.apply(TreeUpdate {
+            nodes: vec![(parent, root), (child, button)],
+            tree: Some(Tree::new(parent)),
+            tree_id: TreeId::ROOT,
+            focus: child,
+        });
+        assert!(first[&child].supports_action(Action::Click));
+        assert!(!first[&child].supports_action(Action::Increment));
+
+        let mut parent_without_child = Node::new(Role::Window);
+        parent_without_child.set_children(Vec::new());
+        let after_remove = state.apply(TreeUpdate {
+            nodes: vec![(parent, parent_without_child)],
+            tree: None,
+            tree_id: TreeId::ROOT,
+            focus: parent,
+        });
+        assert_eq!(after_remove.len(), 1);
+        assert!(!after_remove.contains_key(&child));
+    }
+
+    #[test]
+    fn traits_and_toggled_values_match_uikit() {
+        let heading = Node::new(Role::Heading);
+        let search = Node::new(Role::SearchInput);
+        unsafe {
+            assert_eq!(role_traits(&heading), UIAccessibilityTraitHeader);
+            assert_eq!(role_traits(&search), UIAccessibilityTraitSearchField);
+        }
+        let mut toggle = Node::new(Role::Switch);
+        assert_eq!(toggled_value(&toggle), None);
+        toggle.set_toggled(accesskit::Toggled::True);
+        assert_eq!(toggled_value(&toggle), Some("On"));
+        toggle.set_toggled(accesskit::Toggled::False);
+        assert_eq!(toggled_value(&toggle), Some("Off"));
+        toggle.set_toggled(accesskit::Toggled::Mixed);
+        assert_eq!(toggled_value(&toggle), Some("Mixed"));
+    }
+
+    #[test]
+    fn hidden_parent_filters_descendants_and_button_synthesizes_text_label() {
+        let root_id = NodeId(1);
+        let button_id = NodeId(2);
+        let text_id = NodeId(3);
+        let hidden_id = NodeId(4);
+        let hidden_child_id = NodeId(5);
+        let mut root = Node::new(Role::Window);
+        root.set_children(vec![button_id, hidden_id]);
+        let mut button = Node::new(Role::Button);
+        button.set_children(vec![text_id]);
+        let mut text = Node::new(Role::TextRun);
+        text.set_value("Save");
+        let mut hidden = Node::new(Role::Group);
+        hidden.set_hidden();
+        hidden.set_children(vec![hidden_child_id]);
+        let mut hidden_child = Node::new(Role::Button);
+        hidden_child.set_label("Hidden");
+        let nodes = HashMap::from([
