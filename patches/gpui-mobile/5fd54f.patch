 // ── Safe area insets ─────────────────────────────────────────────────────────
 
+pub(crate) fn logical_window_insets(
+    safe_area: [f32; 4],
+    ime: [f32; 4],
+    scale_factor: f32,
+) -> gpui::WindowInsets {
+    let scale_factor = scale_factor.max(f32::EPSILON);
+    let logical = |edges: [f32; 4]| gpui::Edges {
+        top: gpui::px(edges[0].max(0.0) / scale_factor),
+        bottom: gpui::px(edges[1].max(0.0) / scale_factor),
+        left: gpui::px(edges[2].max(0.0) / scale_factor),
+        right: gpui::px(edges[3].max(0.0) / scale_factor),
+    };
+    gpui::WindowInsets {
+        safe_area: logical(safe_area),
+        ime: logical(ime),
+    }
+}
+
+/// Return inset edges covered by the intersection of a keyboard rect and window.
+/// Rectangles are `(x, y, width, height)` in the same logical coordinate space.
+pub(crate) fn keyboard_occlusion_insets(
+    window_width: f32,
+    window_height: f32,
+    keyboard: [f32; 4],
+) -> [f32; 4] {
+    let [x, y, width, height] = keyboard;
+    let left = x.max(0.0);
+    let top = y.max(0.0);
+    let right = (x + width).min(window_width.max(0.0));
+    let bottom = (y + height).min(window_height.max(0.0));
+    if right <= left || bottom <= top {
+        return [0.0; 4];
+    }
+    let epsilon = 0.5;
+    if bottom >= window_height - epsilon && right - left >= window_width - epsilon {
+        return [0.0, (window_height - top).max(0.0), 0.0, 0.0];
+    }
+    if bottom - top >= window_height - epsilon {
+        return [
+            0.0,
+            0.0,
+            if left <= epsilon { right } else { 0.0 },
+            if right >= window_width - epsilon {
+                (window_width - left).max(0.0)
+            } else {
+                0.0
+            },
+        ];
+    }
+    [if top <= epsilon { bottom } else { 0.0 }, 0.0, 0.0, 0.0]
+}
