+pub(crate) fn apply_a11y_adjust<E: StatefulInteractiveElement>(
+    mut el: E,
+    props: &HashMap<String, serde_json::Value>,
+    events: &std::collections::HashSet<String>,
+    id: u64,
+    callback: &Option<EventCallback>,
+) -> E {
+    if props.get("role").and_then(|v| v.as_str()) != Some("slider")
+        || props.get("tabIndex").and_then(|v| v.as_i64()) == Some(-1)
+        || !events.contains("keyDown")
+    {
+        return el;
+    }
+    for (action, key) in [(AccessibleAction::Increment, "right"), (AccessibleAction::Decrement, "left")] {
+        let callback = callback.clone();
+        el = el.on_a11y_action(action, move |_, _, _| {
+            emit_event_full(&callback, id, "keyDown", |payload| {
+                payload.key = Some(key.to_string());
+                payload.is_held = Some(false);
+            });
+        });
+    }
+    el
+}
