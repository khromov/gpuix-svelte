 /// JS must run from a foreground task, never from an App/entity update closure.
 pub fn install_host(app: AsyncApp) {
     HOST.with(|host| *host.borrow_mut() = Some(app));
+}
+
+/// Dispatch a platform operation through the installed GPUI host on its
+/// foreground event loop. Callers must not invoke this from a GPUI update
+/// closure, which would re-enter the app context.
+pub fn open_url(url: &str) -> Result<()> {
+    let app = HOST
+        .with(|host| host.borrow().clone())
+        .context("No GPUI host installed; cannot open URL")?;
+    app.update(|cx| cx.open_url(url));
+    Ok(())
+}
+
+pub fn read_clipboard_text() -> Result<Option<String>> {
+    let app = HOST.with(|host| host.borrow().clone()).context("No GPUI host installed")?;
+    Ok(app.update(|cx| cx.read_from_clipboard().and_then(|item| item.text())))
+}
+
+pub fn write_clipboard_text(text: &str) -> Result<()> {
+    let app = HOST.with(|host| host.borrow().clone()).context("No GPUI host installed")?;
+    app.update(|cx| cx.write_to_clipboard(gpui::ClipboardItem::new_string(text.to_owned())));
+    Ok(())
 }
 
