+/// A once-only native path picker completion, suitable for an engine's queue.
+pub struct PathPromptSink(Box<dyn FnOnce(Result<Option<Vec<String>>>) + Send>);
+impl PathPromptSink {
+    pub fn new(callback: impl FnOnce(Result<Option<Vec<String>>>) + Send + 'static) -> Self {
+        Self(Box::new(callback))
+    }
+    pub fn settle(self, result: Result<Option<Vec<String>>>) {
+        (self.0)(result);
+    }
+}
+fn element_id(value: f64) -> Result<u64> {
+    raw_element_id(value).map_err(anyhow::Error::msg)
+}
+fn finite(value: f64, name: &str) -> Result<f64> {
+    if !value.is_finite() || value.abs() > f32::MAX as f64 {
+        bail!("Invalid {name}: {value}");
+    }
+    Ok(value)
+}
+fn positive(value: f64, name: &str) -> Result<f64> {
+    finite(value, name)?;
+    if value <= 0.0 {
+        bail!("{name} must be positive");
+    }
+    Ok(value)
+}
+fn dimension(value: f64, name: &str) -> Result<u32> {
+    if !value.is_finite() || value <= 0.0 || value.fract() != 0.0 || value > u32::MAX as f64 {
+        bail!("Invalid {name}: {value}");
+    }
+    Ok(value as u32)
+}
+fn desktop_window_operation() -> Result<()> {
+    if cfg!(any(target_os = "android", target_os = "ios")) {
+        bail!("This window management operation is desktop-only");
+    }
+    Ok(())
+}
+fn overlay_name(mode: gpui::DebugFrameOverlayMode) -> &'static str {
+    match mode {
+        gpui::DebugFrameOverlayMode::Hidden => "hidden",
+        gpui::DebugFrameOverlayMode::Minimal => "minimal",
+        gpui::DebugFrameOverlayMode::Full => "full",
+    }
+}
+fn collect_text(id: u64, tree: &RetainedTree, texts: &mut Vec<String>) {
+    if let Some(element) = tree.elements.get(&id) {
+        if let Some(text) = &element.content {
+            texts.push(text.clone());
+        }
+        for child in &element.children {
+            collect_text(*child, tree, texts);
+        }
+    }
+}
