-            // The first paint only sets the baseline.
-            None => {
-                reports.scrolls.insert(id, offset);
-                return;
-            }
-            Some(last)
-                if (last.0 - offset.0).abs() < PAINT_REPORT_EPSILON
-                    && (last.1 - offset.1).abs() < PAINT_REPORT_EPSILON =>
-            {
-                return;
-            }
-            Some(_) => {
-                reports.scrolls.insert(id, offset);
-            }
-        }
-    }
-    let callback = Some(callback.clone());
-    cx.defer(move |_| {
