-fn virtual_row_ancestor(tree: &RetainedTree, list_id: u64, element_id: u64) -> Option<u64> {
-    let mut current = element_id;
-    loop {
-        let parent = tree.elements.get(&current)?.parent?;
-        if parent == list_id {
-            return Some(current);
-        }
-        current = parent;
-    }
-}
