-fn layer_shell_anchor_bit(name: &str) -> gpui::layer_shell::Anchor {
-    use gpui::layer_shell::Anchor;
-    match name.trim().to_ascii_lowercase().as_str() {
-        "top" => Anchor::TOP,
-        "bottom" => Anchor::BOTTOM,
-        "left" => Anchor::LEFT,
-        "right" => Anchor::RIGHT,
