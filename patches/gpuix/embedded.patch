+    pub fn prompt_for_paths_with(
+        &self,
+        options: Option<PathPromptOptions>,
+        settle: impl FnOnce(Result<Option<Vec<String>>>) + Send + 'static,
+    ) {
+        let result = (|| -> Result<_> {
+            if cfg!(any(target_os = "android", target_os = "ios")) {
+                bail!("Native path pickers are not implemented on this mobile platform");
+            }
+            let options = options.unwrap_or_default();
+            let directories = options.directories.unwrap_or(false);
+            let files = options.files.unwrap_or(!directories);
+            if !files && !directories {
+                bail!("promptForPaths requires files or directories");
+            }
+            if files && directories && !cfg!(target_os = "macos") {
+                bail!("Selecting files and directories together is only supported on macOS");
+            }
+            self.with_window(|_, _, cx| {
+                (
+                    cx.prompt_for_paths(gpui::PathPromptOptions {
+                        files,
+                        directories,
+                        multiple: options.multiple.unwrap_or(false),
+                        prompt: options.prompt.map(Into::into),
+                    }),
+                    cx.background_executor().clone(),
+                )
+            })
+        })();
+        match result {
+            Err(error) => settle(Err(error)),
+            Ok((receiver, executor)) => executor
+                .spawn(async move {
+                    let result = receiver
+                        .await
+                        .context("The path prompt closed without a result")
+                        .and_then(|result| result)
+                        .and_then(|paths| {
+                            paths
+                                .map(|paths| {
+                                    paths
+                                        .into_iter()
+                                        .map(|path| {
+                                            path.into_os_string().into_string().map_err(|_| {
+                                                anyhow!("Selected path is not valid UTF-8")
+                                            })
+                                        })
+                                        .collect()
+                                })
+                                .transpose()
+                        });
+                    settle(result);
+                })
+                .detach(),
+        }
+    }
+}
