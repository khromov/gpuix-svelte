@@ -0,0 +1,725 @@
+//! Synchronous native API for JavaScript running outside GPUI's update borrows.
+use super::*;
+use anyhow::{anyhow, bail, Context as _, Result};
+use gpui::{
+    App, AppContext, AsyncApp, Context, Entity, IntoElement, ParentElement, Render, Styled, Window,
+    WindowHandle,
+};
+use std::cell::Cell;
+
+thread_local! {
+    static HOST: RefCell<Option<AsyncApp>> = const { RefCell::new(None) };
+}
+
+/// Install the foreground app context before evaluating an application's JS.
+/// JS must run from a foreground task, never from an App/entity update closure.
+pub fn install_host(app: AsyncApp) {
+    HOST.with(|host| *host.borrow_mut() = Some(app));
+}
+
+/// A renderer's window owns the native view, not the JavaScript engine.
+struct EmbeddedWindow {
+    view: Entity<GpuixView>,
+}
+
+impl Render for EmbeddedWindow {
+    fn render(&mut self, window: &mut Window, _cx: &mut Context<Self>) -> impl IntoElement {
+        let insets = window.insets().effective();
+        gpui::div()
+            .size_full()
+            .pt(insets.top)
+            .pr(insets.right)
+            .pb(insets.bottom)
+            .pl(insets.left)
+            .child(self.view.clone())
+    }
+}
+
+/// GPUIX's retained renderer hosted in an application-owned event loop.
+/// Every query reads real native state synchronously. Events only enqueue data.
+pub struct EmbeddedRenderer {
+    tree: Arc<Mutex<RetainedTree>>,
+    selection: SharedSelection,
+    event_callback: Option<EventCallback>,
+    app: RefCell<Option<AsyncApp>>,
+    window: Cell<Option<WindowHandle<EmbeddedWindow>>>,
+    initialized: Cell<bool>,
+}
+
+impl EmbeddedRenderer {
+    pub fn with_event_callback(event_callback: Option<EventCallback>) -> Self {
+        Self {
+            tree: Arc::new(Mutex::new(RetainedTree::new())),
+            selection: SharedSelection::default(),
+            event_callback,
+            app: RefCell::new(None),
+            window: Cell::new(None),
+            initialized: Cell::new(false),
+        }
+    }
+
+    pub fn init(&self, options: Option<WindowOptions>) -> Result<()> {
+        if self.initialized.get() {
+            bail!("Renderer already initialized");
+        }
+        let options = options.unwrap_or_default();
+        if options.terminal.unwrap_or(false) {
+            bail!("Terminal rendering is not available in an embedded host; use Node or Bun");
+        }
+        let app = HOST.with(|host| host.borrow().clone()).context(
+            "No GPUI host installed; evaluate JS from the application's foreground task",
+        )?;
+        let width = positive(options.width.unwrap_or(800.0), "width")?;
+        let height = positive(options.height.unwrap_or(600.0), "height")?;
+        for (name, value) in [
+            ("minWidth", options.min_width),
+            ("minHeight", options.min_height),
+        ] {
+            if let Some(value) = value {
+                positive(value, name)?;
+            }
+        }
+        if let Some(background) = &options.window_background {
+            if !matches!(background.as_str(), "opaque" | "transparent" | "blurred") {
+                bail!("Invalid windowBackground: {background}");
+            }
+        }
+        let bounds = app.update(|cx| {
+            gpui::Bounds::centered(
+                None,
+                gpui::size(gpui::px(width as f32), gpui::px(height as f32)),
+                cx,
+            )
+        });
+        let native_options = to_gpui_window_options(&options, bounds);
+        #[cfg(target_os = "macos")]
+        app.update(|cx| {
+            crate::app_menu::init(
+                options
+                    .app_name
+                    .as_deref()
+                    .or(options.title.as_deref())
+                    .unwrap_or("GPUIX"),
+                cx,
+            )
+        });
+        let tree = self.tree.clone();
+        let selection = self.selection.clone();
+        let callback = self.event_callback.clone();
+        let handle = app.open_window(native_options, move |_window, cx| {
+            let view = cx.new(|_cx| GpuixView::new(tree, callback, None, selection));
+            cx.new(|_cx| EmbeddedWindow { view })
+        })?;
+        if options.focus.unwrap_or(true) && options.show.unwrap_or(true) {
+            app.update(|cx| cx.activate(true));
+        }
+        *self.app.borrow_mut() = Some(app);
+        self.window.set(Some(handle));
+        self.initialized.set(true);
+        Ok(())
+    }
+
+    fn with_window<R>(
+        &self,
+        update: impl FnOnce(&Entity<GpuixView>, &mut Window, &mut App) -> R,
+    ) -> Result<R> {
+        let handle = self
+            .window
+            .get()
+            .context("Renderer not initialized. Call init() first.")?;
+        let app = self
+            .app
+            .borrow()
+            .clone()
+            .context("GPUI host is unavailable")?;
+        // Flush notifications after each native call. Do not borrow the root
+        // entity across the call: rendering/input may need to enter it again.
+        app.update(|cx| {
+            cx.update_window(handle.into(), |root, window, cx| {
+                let root = root
+                    .downcast::<EmbeddedWindow>()
+                    .map_err(|_| anyhow!("The renderer window root was replaced"))?;
+                let view = root.read(cx).view.clone();
+                Ok(update(&view, window, cx))
+            })
+        })
+        .context("The renderer window has closed")?
+    }
+
+    fn update<R>(
+        &self,
+        update: impl FnOnce(&mut GpuixView, &mut Window, &mut Context<GpuixView>) -> R,
+    ) -> Result<R> {
+        self.with_window(|view, window, cx| view.update(cx, |view, cx| update(view, window, cx)))
+    }
+
+    fn invalidate(&self) -> Result<()> {
+        self.update(|_view, window, cx| {
+            cx.notify();
+            window.refresh();
+        })
+    }
+
+    pub fn is_initialized(&self) -> bool {
+        self.initialized.get()
+    }
+    pub fn requires_tick(&self) -> bool {
+        true
+    }
+    pub fn tick(&self) -> Result<bool> {
+        if !self.initialized.get() {
+            bail!("Renderer not initialized. Call init() first.");
+        }
+        Ok(self.with_window(|_, _, _| ()).is_ok())
+    }
+
+    pub fn apply_batch(&self, json: String) -> Result<Vec<f64>> {
+        let (destroyed, dirty) = {
+            let mut tree = self
+                .tree
+                .lock()
+                .map_err(|_| anyhow!("Retained tree lock was poisoned"))?;
+            let destroyed =
+                apply_batch_to_tree(&mut tree, json.as_bytes()).map_err(anyhow::Error::msg)?;
+            (destroyed, tree.take_dirty())
+        };
+        if dirty {
+            self.invalidate()?;
+        }
+        Ok(destroyed)
+    }
+
+    pub fn get_window_size(&self) -> Result<WindowSize> {
+        self.with_window(|_, window, _| {
+            let size = window.viewport_size();
+            WindowSize {
+                width: f32::from(size.width) as f64,
+                height: f32::from(size.height) as f64,
+            }
+        })
+    }
+    pub fn get_window_insets(&self) -> Result<WindowInsets> {
+        self.with_window(|_, window, _| WindowInsets::from_gpui(window.insets()))
+    }
+    pub fn set_window_title(&self, title: String) -> Result<()> {
+        self.with_window(|_, window, _| window.set_window_title(&title))
+    }
+    pub fn activate_window(&self) -> Result<()> {
+        self.with_window(|_, window, cx| {
+            cx.activate(true);
+            window.activate_window();
+        })
+    }
+    pub fn minimize_window(&self) -> Result<()> {
+        desktop_window_operation()?;
+        self.with_window(|_, window, _| window.minimize_window())
+    }
+    pub fn zoom_window(&self) -> Result<()> {
+        desktop_window_operation()?;
+        self.with_window(|_, window, _| window.zoom_window())
+    }
+    pub fn toggle_fullscreen(&self) -> Result<()> {
+        desktop_window_operation()?;
+        self.with_window(|_, window, _| window.toggle_fullscreen())
+    }
+    pub fn set_debug_frame_overlay(&self, mode: String) -> Result<String> {
+        let mode = match mode.as_str() {
+            "hidden" => gpui::DebugFrameOverlayMode::Hidden,
+            "minimal" => gpui::DebugFrameOverlayMode::Minimal,
+            "full" => gpui::DebugFrameOverlayMode::Full,
+            _ => bail!("Invalid debug frame overlay mode: {mode}"),
+        };
+        self.with_window(|_, window, _| {
+            window.set_debug_frame_overlay_mode(mode);
+            overlay_name(window.debug_frame_overlay_mode()).to_owned()
+        })
+    }
+    pub fn cycle_debug_frame_overlay(&self) -> Result<String> {
+        self.with_window(|_, window, _| {
+            window.cycle_debug_frame_overlay_mode();
+            overlay_name(window.debug_frame_overlay_mode()).to_owned()
+        })
+    }
+    pub fn get_debug_frame_overlay(&self) -> Result<String> {
+        self.with_window(|_, window, _| overlay_name(window.debug_frame_overlay_mode()).to_owned())
+    }
+    pub fn reset_debug_frame_overlay_stats(&self) -> Result<()> {
+        self.with_window(|_, window, _| window.reset_debug_frame_overlay_stats())
+    }
+    pub fn get_debug_frame_overlay_stats(&self) -> Result<serde_json::Value> {
+        self.with_window(|_, window, _| {
+            let stats = window.debug_frame_overlay_stats();
+            serde_json::json!({ "currentMs": stats.current_ms, "p90Ms": stats.p90_ms,
+                "p99Ms": stats.p99_ms, "maxMs": stats.max_ms, "frames": stats.frames, "samples": stats.samples })
+        })
+    }
+
+    pub fn focus_element(&self, id: f64) -> Result<()> {
+        let id = element_id(id)?;
+        self.update(|view, window, cx| view.request_focus(id, window, cx))
+    }
+    pub fn focus_next(&self) -> Result<()> {
+        self.with_window(|_, window, cx| window.focus_next(cx))
+    }
+    pub fn focus_previous(&self) -> Result<()> {
+        self.with_window(|_, window, cx| window.focus_prev(cx))
+    }
+    pub fn get_focused_element_id(&self) -> Result<Option<f64>> {
+        self.update(|view, window, _| view.focused_element_id(window).map(|id| id as f64))
+    }
+    pub fn focus_next_within(&self, id: f64) -> Result<()> {
+        let id = element_id(id)?;
+        self.update(|view, window, cx| view.focus_next_within(id, window, cx))
+    }
+    pub fn focus_previous_within(&self, id: f64) -> Result<()> {
+        let id = element_id(id)?;
+        self.update(|view, window, cx| view.focus_previous_within(id, window, cx))
+    }
+    pub fn blur(&self) -> Result<()> {
+        self.with_window(|_, window, cx| window.blur(cx))
+    }
+    pub fn set_window_key_events(&self, down: bool, up: bool, id: f64) -> Result<()> {
+        let id = element_id(id)?;
+        self.update(|view, window, cx| {
+            view.window_key_down = down;
+            view.window_key_up = up;
+            view.window_key_event_id = id;
+            cx.notify();
+            window.refresh();
+        })
+    }
+    pub fn set_window_selection_change(&self, enabled: bool, id: f64) -> Result<()> {
+        let id = element_id(id)?;
+        self.update(|view, window, cx| {
+            view.set_selection_change_listener(enabled, id);
+            cx.notify();
+            window.refresh();
+        })
+    }
+    pub fn get_selected_text(&self) -> Option<String> {
+        self.selection.lock().selected_text()
+    }
+    pub fn clear_selection(&self) -> Result<()> {
+        self.selection.lock().clear();
+        self.invalidate()
+    }
+
+    pub fn scroll_to(&self, id: f64, x: f64, y: f64) -> Result<()> {
+        let id = element_id(id)?;
+        finite(x, "x")?;
+        finite(y, "y")?;
+        if !VIRTUAL_LIST_STATES.with(|states| {
+            if let Some(state) = states.borrow().get(&id) {
+                state
+                    .set_offset_from_scrollbar(gpui::point(gpui::px(x as f32), gpui::px(y as f32)));
+                true
+            } else {
+                false
+            }
+        }) {
+            SCROLL_HANDLES.with(|handles| {
+                if let Some(handle) = handles.borrow().get(&id) {
+                    handle.set_offset(gpui::point(gpui::px(x as f32), gpui::px(y as f32)));
+                }
+            });
+        }
+        self.invalidate()
+    }
+    pub fn scroll_to_item(&self, id: f64, index: f64, offset: Option<f64>) -> Result<()> {
+        let id = element_id(id)?;
+        let index = element_id(index)? as usize;
+        let offset = finite(offset.unwrap_or(0.0), "offsetInItem")? as f32;
+        if VIRTUAL_LIST_STATES.with(|states| states.borrow().contains_key(&id)) {
+            queue_virtual_list_scroll(id, index, offset);
+        } else {
+            SCROLL_HANDLES.with(|handles| {
+                if let Some(handle) = handles.borrow().get(&id) {
+                    handle.scroll_to_item(index);
+                }
+            });
+        }
+        self.invalidate()
+    }
+    pub fn get_list_scroll_top(&self, id: f64) -> Result<Option<Vec<f64>>> {
+        let id = element_id(id)?;
+        self.update(|view, _, _| view.virtual_list_scroll_top(id).map(|value| value.to_vec()))
+    }
+    pub fn get_scroll_offset(&self, id: f64) -> Result<Option<Vec<f64>>> {
+        let id = element_id(id)?;
+        Ok(VIRTUAL_LIST_STATES
+            .with(|states| {
+                states.borrow().get(&id).map(|state| {
+                    let p = state.scroll_px_offset_for_scrollbar();
+                    vec![f32::from(p.x) as f64, f32::from(p.y) as f64]
+                })
+            })
+            .or_else(|| {
+                SCROLL_HANDLES.with(|handles| {
+                    handles.borrow().get(&id).map(|handle| {
+                        let p = handle.offset();
+                        vec![f32::from(p.x) as f64, f32::from(p.y) as f64]
+                    })
+                })
+            }))
+    }
+    pub fn scroll_into_view(&self, id: f64) -> Result<()> {
+        let id = element_id(id)?;
+        self.update(|view, window, cx| {
+            if view.scroll_element_into_view(id) {
+                cx.notify();
+                window.refresh();
+            }
+        })
+    }
+    pub fn set_image_pixels_bytes(
+        &self,
+        id: f64,
+        width: f64,
+        height: f64,
+        bytes: Vec<u8>,
+        format: Option<String>,
+    ) -> Result<()> {
+        let id = element_id(id)?;
+        let width = dimension(width, "width")?;
+        let height = dimension(height, "height")?;
+        let format = crate::custom_elements::img::PixelFormat::parse(format.as_deref())
+            .map_err(anyhow::Error::msg)?;
+        self.update(move |view, window, cx| {
+            view.set_image_pixels(id, width, height, bytes, format, window, cx)
+        })?
+        .map_err(anyhow::Error::msg)
+    }
+    pub fn set_image_bytes(&self, id: f64, bytes: Vec<u8>) -> Result<()> {
+        let id = element_id(id)?;
+        self.update(move |view, window, cx| view.set_encoded_image(id, bytes, window, cx))?
+            .map_err(anyhow::Error::msg)
+    }
+    pub fn register_font_bytes(&self, bytes: Vec<u8>) -> Result<()> {
+        self.update(move |view, window, cx| view.register_font(bytes, window, cx))?
+            .map_err(anyhow::Error::msg)
+    }
+    pub fn get_automation_tree(&self) -> Result<String> {
+        let bounds = crate::automation::all_bounds();
+        let tree = self
+            .tree
+            .lock()
+            .map_err(|_| anyhow!("Retained tree lock was poisoned"))?;
+        Ok(serde_json::to_string(&tree.to_automation_json(&bounds))?)
+    }
+    pub fn get_element_bounds(&self, id: f64) -> Result<Option<ElementBounds>> {
+        Ok(crate::automation::get_bounds(element_id(id)?).map(ElementBounds::from_painted))
+    }
+    pub fn get_elements_at(&self, x: f64, y: f64) -> Result<Vec<f64>> {
+        finite(x, "x")?;
+        finite(y, "y")?;
+        Ok(self
+            .tree
+            .lock()
+            .map_err(|_| anyhow!("Retained tree lock was poisoned"))?
+            .elements_at(x, y, &crate::automation::get_bounds)
+            .into_iter()
+            .map(|id| id as f64)
+            .collect())
+    }
+    pub fn get_all_text(&self) -> Vec<String> {
+        let tree = self.tree.lock().unwrap_or_else(|error| error.into_inner());
+        let mut texts = Vec::new();
+        if let Some(root) = tree.root_id {
+            collect_text(root, &tree, &mut texts);
+        }
+        texts
+    }
+    pub fn get_painted_text(&self) -> Vec<String> {
+        crate::text::painted_text()
+    }
+    pub fn get_painted_highlights(&self) -> Vec<crate::element_tree::HighlightMatch> {
+        crate::text::painted_highlights()
+            .into_iter()
+            .map(Into::into)
+            .collect()
