{
	"name": "gpuix-svelte",
	"version": "0.6.0",
	"description": "Svelte custom renderer for GPUI (Zed's GPU-accelerated UI framework), via @gpuix/native",
	"type": "module",
	"license": "MIT",
	"author": "Stanislav Khromov",
	"main": "src/index.ts",
	"bin": {
		"gpuix-svelte": "bin/gpuix-svelte.js"
	},
	"exports": {
		".": {
			"custom-renderer": {
				"browser": "./src/web.ts",
				"default": "./src/index.ts"
			},
			"default": "./src/dom.ts"
		},
		"./dom": "./src/dom.ts",
		"./renderer": "./src/renderer.ts",
		"./plugin": "./src/plugin.ts",
		"./build": "./src/build.ts",
		"./update": {
			"browser": "./src/update-web.ts",
			"default": "./src/update.ts"
		},
		"./register": "./src/register.ts",
		"./test": "./src/test.ts",
		"./automation": "./src/automation.ts",
		"./components/*": {
			"custom-renderer": "./src/components/*",
			"default": "./src/components/dom/*"
		},
		"./html": {
			"types": "./src/html.d.ts"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"bin",
		"assets/icon.png"
	],
	"engines": {
		"node": ">=24.0.0",
		"bun": ">=1.4.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/khromov/gpuix-svelte"
	},
	"homepage": "https://gpuix-svelte.stanislav.garden",
	"keywords": [
		"svelte",
		"gpui",
		"gpuix",
		"custom-renderer",
		"native",
		"gui",
		"node"
	],
	"scripts": {
		"typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --diagnostic-sources js,svelte --fail-on-warnings --output human && svelte-check --tsconfig ./tsconfig.dom.json --diagnostic-sources js,svelte --fail-on-warnings --output human",
		"lint": "eslint .",
		"check:svelte": "node --use-env-proxy scripts/svelte-mcp.ts",
		"demo": "node scripts/demo-all.ts",
		"demo:counter": "node bin/gpuix-svelte.js examples/counter/main.ts",
		"demo:tictactoe": "node bin/gpuix-svelte.js examples/tic-tac-toe/main.ts",
		"demo:hn": "node bin/gpuix-svelte.js examples/hacker-news/main.ts",
		"demo:glass": "node bin/gpuix-svelte.js examples/liquid-glass/main.ts",
		"demo:glass-ffi": "node bin/gpuix-svelte.js --experimental-ffi examples/liquid-glass-ffi/main.ts",
		"demo:styling": "node bin/gpuix-svelte.js examples/styling-playground/main.ts",
		"demo:desktop": "node bin/gpuix-svelte.js examples/desktop-apis/main.ts",
		"demo:native-0.11": "node bin/gpuix-svelte.js examples/native-0.11/main.ts",
		"demo:web": "bun scripts/web.ts",
		"demo:cross": "node bin/gpuix-svelte.js examples/cross-target/main.ts",
		"demo:dom": "node scripts/dom.ts",
		"demo:ui": "node bin/gpuix-svelte.js packages/ui/showcase/main.ts",
		"demo:ui-app": "node bin/gpuix-svelte.js examples/ui-app/main.ts",
		"demo:ui-dom": "node scripts/dom.ts --root packages/ui/showcase",
		"pack:ui": "node scripts/publish-ui.ts pack",
		"publish:ui": "node scripts/publish-ui.ts publish",
		"tutorial": "node bin/gpuix-svelte.js examples/tutorial/main.ts",
		"test": "npm run typecheck && npm run test:reorder && npm run test:smoke && npm run test:autocommit && npm run test:style && npm run test:props && npm run test:teardown && npm run test:lifecycle && npm run test:compile && npm run test:css && npm run test:module && npm run test:vars && npm run test:root-vars && npm run test:scroller && npm run test:dialog && npm run test:hitbox && npm run test:auxclick && npm run test:window-keys && npm run test:tab && npm run test:button && npm run test:titlebar && npm run test:portal && npm run test:host && npm run test:overlay && npm run test:window && npm run test:media && npm run test:helpers && npm run test:search && npm run test:tooltip && npm run test:cross-target && npm run test:dom && npm run test:ui && npm run test:ui-dom && npm run test:docs && npm run test:automation && npm run test:bundle && npm run test:update && npm run test:launcher",
		"test:cross-target": "node bin/gpuix-svelte.js test/cross-target.ts",
		"test:ui": "node bin/gpuix-svelte.js test/ui.ts",
		"test:ui-dom": "node bin/gpuix-svelte.js test/ui-dom.ts",
		"test:dom": "node bin/gpuix-svelte.js test/dom.ts",
		"test:docs": "node bin/gpuix-svelte.js test/docs.ts",
		"test:bundle": "node bin/gpuix-svelte.js test/bundle.ts",
		"test:update": "node bin/gpuix-svelte.js test/update.ts",
		"test:launcher": "node bin/gpuix-svelte.js test/launcher.ts",
		"test:vars": "node bin/gpuix-svelte.js test/vars.ts",
		"test:root-vars": "node bin/gpuix-svelte.js test/root-vars.ts",
		"test:scroller": "node bin/gpuix-svelte.js test/scroller.ts",
		"test:dialog": "node bin/gpuix-svelte.js test/dialog.ts",
		"test:hitbox": "node bin/gpuix-svelte.js test/hitbox.ts",
		"test:auxclick": "node bin/gpuix-svelte.js test/auxclick.ts",
		"test:window-keys": "node bin/gpuix-svelte.js test/window-keys.ts",
		"test:tab": "node bin/gpuix-svelte.js test/tab.ts",
		"test:button": "node bin/gpuix-svelte.js test/button.ts",
		"test:titlebar": "node bin/gpuix-svelte.js test/titlebar.ts",
		"test:portal": "node bin/gpuix-svelte.js test/portal.ts",
		"test:host": "node bin/gpuix-svelte.js test/host.ts",
		"test:helpers": "node bin/gpuix-svelte.js test/helpers.ts",
		"test:search": "node bin/gpuix-svelte.js test/search.ts",
		"test:tooltip": "node bin/gpuix-svelte.js test/tooltip.ts",
		"test:automation": "node bin/gpuix-svelte.js test/automation.ts",
		"test:automation-live": "node bin/gpuix-svelte.js test/automation-live.ts",
		"test:reorder": "node bin/gpuix-svelte.js test/reorder.ts",
		"test:smoke": "node bin/gpuix-svelte.js test/smoke.ts",
		"test:autocommit": "node bin/gpuix-svelte.js test/autocommit.ts",
		"test:compile": "node bin/gpuix-svelte.js test/compile.ts",
		"test:css": "node bin/gpuix-svelte.js test/css.ts",
		"test:module": "node bin/gpuix-svelte.js test/module.ts",
		"test:lifecycle": "node bin/gpuix-svelte.js test/lifecycle.ts",
		"test:teardown": "node bin/gpuix-svelte.js test/teardown.ts",
		"test:overlay": "node bin/gpuix-svelte.js test/overlay.ts",
		"test:style": "node bin/gpuix-svelte.js test/style.ts",
		"test:props": "node bin/gpuix-svelte.js test/props.ts",
		"test:window": "node bin/gpuix-svelte.js test/window.ts",
		"test:media": "node bin/gpuix-svelte.js test/media.ts && node bin/gpuix-svelte.js test/media-default.ts",
		"test:coverage": "node bin/gpuix-svelte.js test/coverage.ts",
		"docs": "node scripts/docs.ts",
		"docs:serve": "node scripts/docs.ts --serve",
		"og": "node scripts/og.ts",
		"wallpapers": "node scripts/wallpapers.ts",
		"og:docs": "node scripts/docs.ts && node scripts/og.ts --root dist/docs --path overview.html --out docs/assets/og-docs.png",
		"shots": "node bin/gpuix-svelte.js scripts/shots.ts",
		"vendor": "node --use-env-proxy scripts/vendor-svelte.ts",
		"parity": "node scripts/native-parity.ts",
		"pack": "node scripts/publish.ts pack",
		"publish:npm": "node scripts/publish.ts publish",
		"consume": "node scripts/consume.ts",
		"consume:open": "node scripts/consume.ts --open",
		"compile": "bun scripts/compile.ts",
		"bun:typecheck": "npm run typecheck",
		"bun:consume": "node scripts/consume.ts --bun",
		"bun:consume:open": "node scripts/consume.ts --bun --open",
		"bun:demo": "node scripts/demo-all.ts --bun",
		"bun:demo:counter": "node bin/gpuix-svelte.js --bun examples/counter/main.ts",
		"bun:demo:tictactoe": "node bin/gpuix-svelte.js --bun examples/tic-tac-toe/main.ts",
		"bun:demo:hn": "node bin/gpuix-svelte.js --bun examples/hacker-news/main.ts",
		"bun:demo:glass": "node bin/gpuix-svelte.js --bun examples/liquid-glass/main.ts",
		"bun:demo:glass-ffi": "node bin/gpuix-svelte.js --bun examples/liquid-glass-ffi/main.ts",
		"bun:demo:styling": "node bin/gpuix-svelte.js --bun examples/styling-playground/main.ts",
		"bun:demo:desktop": "node bin/gpuix-svelte.js --bun examples/desktop-apis/main.ts",
		"bun:demo:native-0.11": "node bin/gpuix-svelte.js --bun examples/native-0.11/main.ts",
		"bun:demo:cross": "node bin/gpuix-svelte.js --bun examples/cross-target/main.ts",
		"bun:demo:ui": "node bin/gpuix-svelte.js --bun packages/ui/showcase/main.ts",
		"bun:demo:ui-app": "node bin/gpuix-svelte.js --bun examples/ui-app/main.ts",
		"bun:tutorial": "node bin/gpuix-svelte.js --bun examples/tutorial/main.ts",
		"bun:test": "npm run bun:typecheck && npm run bun:test:reorder && npm run bun:test:smoke && npm run bun:test:autocommit && npm run bun:test:style && npm run bun:test:props && npm run bun:test:teardown && npm run bun:test:lifecycle && npm run bun:test:compile && npm run bun:test:css && npm run bun:test:module && npm run bun:test:vars && npm run bun:test:root-vars && npm run bun:test:scroller && npm run bun:test:dialog && npm run bun:test:hitbox && npm run bun:test:auxclick && npm run bun:test:window-keys && npm run bun:test:tab && npm run bun:test:button && npm run bun:test:titlebar && npm run bun:test:portal && npm run bun:test:host && npm run bun:test:overlay && npm run bun:test:window && npm run bun:test:media && npm run bun:test:helpers && npm run bun:test:search && npm run bun:test:tooltip && npm run bun:test:cross-target && npm run bun:test:dom && npm run bun:test:ui && npm run bun:test:ui-dom && npm run bun:test:docs && npm run bun:test:automation && npm run bun:test:bundle && npm run bun:test:update && npm run bun:test:launcher",
		"bun:test:cross-target": "node bin/gpuix-svelte.js --bun test/cross-target.ts",
		"bun:test:ui": "node bin/gpuix-svelte.js --bun test/ui.ts",
		"bun:test:ui-dom": "node bin/gpuix-svelte.js --bun test/ui-dom.ts",
		"bun:test:dom": "node bin/gpuix-svelte.js --bun test/dom.ts",
		"bun:test:docs": "node bin/gpuix-svelte.js --bun test/docs.ts",
		"bun:test:bundle": "node bin/gpuix-svelte.js --bun test/bundle.ts",
		"bun:test:update": "node bin/gpuix-svelte.js --bun test/update.ts",
		"bun:test:launcher": "node bin/gpuix-svelte.js --bun test/launcher.ts",
		"bun:test:vars": "node bin/gpuix-svelte.js --bun test/vars.ts",
		"bun:test:root-vars": "node bin/gpuix-svelte.js --bun test/root-vars.ts",
		"bun:test:scroller": "node bin/gpuix-svelte.js --bun test/scroller.ts",
		"bun:test:dialog": "node bin/gpuix-svelte.js --bun test/dialog.ts",
		"bun:test:hitbox": "node bin/gpuix-svelte.js --bun test/hitbox.ts",
		"bun:test:auxclick": "node bin/gpuix-svelte.js --bun test/auxclick.ts",
		"bun:test:window-keys": "node bin/gpuix-svelte.js --bun test/window-keys.ts",
		"bun:test:tab": "node bin/gpuix-svelte.js --bun test/tab.ts",
		"bun:test:button": "node bin/gpuix-svelte.js --bun test/button.ts",
		"bun:test:titlebar": "node bin/gpuix-svelte.js --bun test/titlebar.ts",
		"bun:test:portal": "node bin/gpuix-svelte.js --bun test/portal.ts",
		"bun:test:host": "node bin/gpuix-svelte.js --bun test/host.ts",
		"bun:test:helpers": "node bin/gpuix-svelte.js --bun test/helpers.ts",
		"bun:test:search": "node bin/gpuix-svelte.js --bun test/search.ts",
