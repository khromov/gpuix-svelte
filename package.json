{
	"name": "gpuix-svelte",
	"version": "0.1.0",
	"description": "Svelte custom renderer for GPUI (Zed's GPU-accelerated UI framework), via @gpuix/native",
	"type": "module",
	"license": "MIT",
	"author": "Stanislav Khromov",
	"main": "src/index.js",
	"bin": {
		"gpuix-svelte": "bin/gpuix-svelte.js"
	},
	"exports": {
		".": "./src/index.js",
		"./renderer": "./src/renderer.js",
		"./plugin": "./src/plugin.js",
		"./register": "./src/register.js",
		"./test": "./src/test.js",
		"./components/*": "./src/components/*",
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"bin"
	],
	"engines": {
		"node": ">=26.1.0",
		"bun": ">=1.4.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/khromov/gpuix-svelte"
	},
	"keywords": [
		"svelte",
		"gpui",
		"gpuix",
		"custom-renderer",
		"native",
		"gui",
		"node"
	],
	"scripts": {
		"demo": "node scripts/demo-all.js",
		"demo:counter": "node bin/gpuix-svelte.js examples/counter/main.js",
		"demo:tictactoe": "node bin/gpuix-svelte.js examples/tic-tac-toe/main.js",
		"demo:hn": "node bin/gpuix-svelte.js examples/hacker-news/main.js",
		"demo:glass": "node bin/gpuix-svelte.js examples/liquid-glass/main.js",
		"demo:glass-ffi": "node bin/gpuix-svelte.js --experimental-ffi examples/liquid-glass-ffi/main.js",
		"demo:styling": "node bin/gpuix-svelte.js examples/styling-playground/main.js",
		"tutorial": "node bin/gpuix-svelte.js examples/tutorial/main.js",
		"brain": "node bin/gpuix-svelte.js --bun examples/second-brain/main.js",
		"brain:install": "npm install --prefix examples/second-brain/ml --no-audit --no-fund",
		"brain:doctor": "bun examples/second-brain/ml/doctor.js",
		"brain:compile": "bun scripts/compile-brain.js",
		"brain:import-hn": "bun examples/second-brain/scripts/import-hn.js",
		"test": "npm run test:reorder && npm run test:smoke && npm run test:autocommit && npm run test:style && npm run test:teardown && npm run test:lifecycle && npm run test:compile && npm run test:css && npm run test:module && npm run test:vars && npm run test:scroller && npm run test:hitbox && npm run test:window-keys",
		"test:vars": "node bin/gpuix-svelte.js test/vars.js",
		"test:scroller": "node bin/gpuix-svelte.js test/scroller.js",
		"test:hitbox": "node bin/gpuix-svelte.js test/hitbox.js",
		"test:window-keys": "node bin/gpuix-svelte.js test/window-keys.js",
		"test:reorder": "node bin/gpuix-svelte.js test/reorder.js",
		"test:smoke": "node bin/gpuix-svelte.js test/smoke.js",
		"test:autocommit": "node bin/gpuix-svelte.js test/autocommit.js",
		"test:compile": "node bin/gpuix-svelte.js test/compile.js",
		"test:css": "node bin/gpuix-svelte.js test/css.js",
		"test:module": "node bin/gpuix-svelte.js test/module.js",
		"test:brain": "node bin/gpuix-svelte.js --bun examples/second-brain/test/brain.js && node bin/gpuix-svelte.js --bun examples/second-brain/test/smoke.js",
		"test:lifecycle": "node bin/gpuix-svelte.js test/lifecycle.js",
		"test:teardown": "node bin/gpuix-svelte.js test/teardown.js",
		"test:style": "node bin/gpuix-svelte.js test/style.js",
		"test:coverage": "node bin/gpuix-svelte.js test/coverage.js",
		"vendor": "node scripts/vendor-svelte.js",
		"compile": "bun scripts/compile.js",
		"compile:app": "bun scripts/compile.js --app",
		"bun:demo": "node scripts/demo-all.js --bun",
		"bun:demo:counter": "node bin/gpuix-svelte.js --bun examples/counter/main.js",
		"bun:demo:tictactoe": "node bin/gpuix-svelte.js --bun examples/tic-tac-toe/main.js",
		"bun:demo:hn": "node bin/gpuix-svelte.js --bun examples/hacker-news/main.js",
		"bun:demo:glass": "node bin/gpuix-svelte.js --bun examples/liquid-glass/main.js",
		"bun:demo:glass-ffi": "node bin/gpuix-svelte.js --bun examples/liquid-glass-ffi/main.js",
		"bun:demo:styling": "node bin/gpuix-svelte.js --bun examples/styling-playground/main.js",
		"bun:tutorial": "node bin/gpuix-svelte.js --bun examples/tutorial/main.js",
		"bun:brain": "node bin/gpuix-svelte.js --bun examples/second-brain/main.js",
		"bun:test": "npm run bun:test:reorder && npm run bun:test:smoke && npm run bun:test:autocommit && npm run bun:test:style && npm run bun:test:teardown && npm run bun:test:lifecycle && npm run bun:test:compile && npm run bun:test:css && npm run bun:test:module && npm run bun:test:vars && npm run bun:test:scroller && npm run bun:test:hitbox && npm run bun:test:window-keys && npm run bun:test:brain",
		"bun:test:vars": "node bin/gpuix-svelte.js --bun test/vars.js",
		"bun:test:scroller": "node bin/gpuix-svelte.js --bun test/scroller.js",
		"bun:test:hitbox": "node bin/gpuix-svelte.js --bun test/hitbox.js",
		"bun:test:window-keys": "node bin/gpuix-svelte.js --bun test/window-keys.js",
		"bun:test:reorder": "node bin/gpuix-svelte.js --bun test/reorder.js",
		"bun:test:smoke": "node bin/gpuix-svelte.js --bun test/smoke.js",
		"bun:test:autocommit": "node bin/gpuix-svelte.js --bun test/autocommit.js",
		"bun:test:compile": "node bin/gpuix-svelte.js --bun test/compile.js",
		"bun:test:css": "node bin/gpuix-svelte.js --bun test/css.js",
		"bun:test:module": "node bin/gpuix-svelte.js --bun test/module.js",
		"bun:test:brain": "npm run test:brain",
		"bun:test:lifecycle": "node bin/gpuix-svelte.js --bun test/lifecycle.js",
		"bun:test:teardown": "node bin/gpuix-svelte.js --bun test/teardown.js",
		"bun:test:style": "node bin/gpuix-svelte.js --bun test/style.js",
		"bun:test:coverage": "node bin/gpuix-svelte.js --bun test/coverage.js"
	},
	"dependencies": {
		"@gpuix/native": ">=0.7.0 <=0.8.0",
		"acorn": "^8.18.0"
	},
	"peerDependencies": {
		"svelte": ">=5.56.0"
	},
	"devDependencies": {
		"svelte": "file:vendor/svelte-5.57.0-6be4ab9.tgz"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	}
}
