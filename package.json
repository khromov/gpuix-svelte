		"bun:test:media": "node bin/gpuix-svelte.js --bun test/media.ts && node bin/gpuix-svelte.js --bun test/media-default.ts",
		"bun:test:coverage": "node bin/gpuix-svelte.js --bun test/coverage.ts"
