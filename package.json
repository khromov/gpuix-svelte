{
	"name": "gpuix-svelte",
	"version": "0.1.0",
	"description": "Svelte custom renderer for GPUI (Zed's GPU-accelerated UI framework), via @gpuix/native",
	"type": "module",
	"license": "MIT",
	"author": "Stanislav Khromov",
	"main": "src/index.ts",
	"bin": {
		"gpuix-svelte": "bin/gpuix-svelte.js"
	},
	"exports": {
		".": "./src/index.ts",
		"./renderer": "./src/renderer.ts",
		"./plugin": "./src/plugin.ts",
		"./register": "./src/register.ts",
		"./test": "./src/test.ts",
		"./components/*": "./src/components/*",
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"bin"
	],
	"engines": {
		"node": ">=24.0.0",
		"bun": ">=1.4.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/khromov/gpuix-svelte"
	},
	"keywords": [
		"svelte",
		"gpui",
		"gpuix",
		"custom-renderer",
		"native",
		"gui",
		"node"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"demo": "node --import tsx scripts/demo-all.ts",
		"demo:counter": "node bin/gpuix-svelte.js examples/counter/main.ts",
		"demo:tictactoe": "node bin/gpuix-svelte.js examples/tic-tac-toe/main.ts",
		"demo:hn": "node bin/gpuix-svelte.js examples/hacker-news/main.ts",
		"demo:glass": "node bin/gpuix-svelte.js examples/liquid-glass/main.ts",
		"demo:glass-ffi": "node bin/gpuix-svelte.js --experimental-ffi examples/liquid-glass-ffi/main.ts",
		"demo:styling": "node bin/gpuix-svelte.js examples/styling-playground/main.ts",
		"tutorial": "node bin/gpuix-svelte.js examples/tutorial/main.ts",
		"brain": "node bin/gpuix-svelte.js --bun examples/second-brain/main.ts",
		"brain:install": "npm install --prefix examples/second-brain/ml --no-audit --no-fund",
		"brain:doctor": "bun examples/second-brain/ml/doctor.ts",
		"brain:compile": "bun scripts/compile-brain.ts",
		"brain:import-hn": "bun examples/second-brain/scripts/import-hn.ts",
		"brain:frames": "node bin/gpuix-svelte.js --bun examples/second-brain/scripts/frame-cost.ts",
		"test": "npm run typecheck && npm run test:reorder && npm run test:smoke && npm run test:autocommit && npm run test:style && npm run test:teardown && npm run test:lifecycle && npm run test:compile && npm run test:css && npm run test:module && npm run test:vars && npm run test:scroller && npm run test:hitbox && npm run test:window-keys && npm run test:portal",
		"test:vars": "node bin/gpuix-svelte.js test/vars.ts",
		"test:scroller": "node bin/gpuix-svelte.js test/scroller.ts",
		"test:hitbox": "node bin/gpuix-svelte.js test/hitbox.ts",
		"test:window-keys": "node bin/gpuix-svelte.js test/window-keys.ts",
		"test:portal": "node bin/gpuix-svelte.js test/portal.ts",
		"test:reorder": "node bin/gpuix-svelte.js test/reorder.ts",
		"test:smoke": "node bin/gpuix-svelte.js test/smoke.ts",
		"test:autocommit": "node bin/gpuix-svelte.js test/autocommit.ts",
		"test:compile": "node bin/gpuix-svelte.js test/compile.ts",
		"test:css": "node bin/gpuix-svelte.js test/css.ts",
		"test:module": "node bin/gpuix-svelte.js test/module.ts",
		"test:brain": "node bin/gpuix-svelte.js --bun examples/second-brain/test/brain.ts && node bin/gpuix-svelte.js --bun examples/second-brain/test/smoke.ts",
		"test:lifecycle": "node bin/gpuix-svelte.js test/lifecycle.ts",
		"test:teardown": "node bin/gpuix-svelte.js test/teardown.ts",
		"test:style": "node bin/gpuix-svelte.js test/style.ts",
		"test:coverage": "node bin/gpuix-svelte.js test/coverage.ts",
		"vendor": "node --import tsx scripts/vendor-svelte.ts",
		"pack": "node --import tsx scripts/publish.ts pack",
		"publish:npm": "node --import tsx scripts/publish.ts publish",
		"consume": "node --import tsx scripts/consume.ts",
		"consume:open": "node --import tsx scripts/consume.ts --open",
		"compile": "bun scripts/compile.ts",
		"compile:app": "bun scripts/compile.ts --app",
		"bun:typecheck": "npm run typecheck",
		"bun:consume": "node --import tsx scripts/consume.ts --bun",
		"bun:consume:open": "node --import tsx scripts/consume.ts --bun --open",
		"bun:demo": "node --import tsx scripts/demo-all.ts --bun",
		"bun:demo:counter": "node bin/gpuix-svelte.js --bun examples/counter/main.ts",
		"bun:demo:tictactoe": "node bin/gpuix-svelte.js --bun examples/tic-tac-toe/main.ts",
		"bun:demo:hn": "node bin/gpuix-svelte.js --bun examples/hacker-news/main.ts",
		"bun:demo:glass": "node bin/gpuix-svelte.js --bun examples/liquid-glass/main.ts",
		"bun:demo:glass-ffi": "node bin/gpuix-svelte.js --bun examples/liquid-glass-ffi/main.ts",
		"bun:demo:styling": "node bin/gpuix-svelte.js --bun examples/styling-playground/main.ts",
		"bun:tutorial": "node bin/gpuix-svelte.js --bun examples/tutorial/main.ts",
		"bun:brain": "node bin/gpuix-svelte.js --bun examples/second-brain/main.ts",
		"bun:test": "npm run bun:typecheck && npm run bun:test:reorder && npm run bun:test:smoke && npm run bun:test:autocommit && npm run bun:test:style && npm run bun:test:teardown && npm run bun:test:lifecycle && npm run bun:test:compile && npm run bun:test:css && npm run bun:test:module && npm run bun:test:vars && npm run bun:test:scroller && npm run bun:test:hitbox && npm run bun:test:window-keys && npm run bun:test:portal && npm run bun:test:brain",
		"bun:test:vars": "node bin/gpuix-svelte.js --bun test/vars.ts",
		"bun:test:scroller": "node bin/gpuix-svelte.js --bun test/scroller.ts",
		"bun:test:hitbox": "node bin/gpuix-svelte.js --bun test/hitbox.ts",
		"bun:test:window-keys": "node bin/gpuix-svelte.js --bun test/window-keys.ts",
		"bun:test:portal": "node bin/gpuix-svelte.js --bun test/portal.ts",
		"bun:test:reorder": "node bin/gpuix-svelte.js --bun test/reorder.ts",
		"bun:test:smoke": "node bin/gpuix-svelte.js --bun test/smoke.ts",
		"bun:test:autocommit": "node bin/gpuix-svelte.js --bun test/autocommit.ts",
		"bun:test:compile": "node bin/gpuix-svelte.js --bun test/compile.ts",
		"bun:test:css": "node bin/gpuix-svelte.js --bun test/css.ts",
		"bun:test:module": "node bin/gpuix-svelte.js --bun test/module.ts",
		"bun:test:brain": "npm run test:brain",
		"bun:test:lifecycle": "node bin/gpuix-svelte.js --bun test/lifecycle.ts",
		"bun:test:teardown": "node bin/gpuix-svelte.js --bun test/teardown.ts",
		"bun:test:style": "node bin/gpuix-svelte.js --bun test/style.ts",
		"bun:test:coverage": "node bin/gpuix-svelte.js --bun test/coverage.ts"
	},
	"dependencies": {
		"@gpuix/native": ">=0.7.0 <=0.8.0",
		"acorn": "^8.18.0",
		"svelte": "file:vendor/svelte-5.57.0-6be4ab9.tgz",
		"tsx": "^4.23.13"
	},
	"bundleDependencies": [
		"svelte"
	],
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.1",
		"eslint": "^10.9.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"marked": "^18.0.11",
		"mpg123-decoder": "^1.0.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.69.0",
		"wasm-media-encoders": "^0.7.0"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	}
}
