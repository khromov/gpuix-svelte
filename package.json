		"bun:test:automation-live": "node bin/gpuix-svelte.js --bun test/automation-live.ts",
		"bun:test:reorder": "node bin/gpuix-svelte.js --bun test/reorder.ts",
		"bun:test:smoke": "node bin/gpuix-svelte.js --bun test/smoke.ts",
		"bun:test:autocommit": "node bin/gpuix-svelte.js --bun test/autocommit.ts",
		"bun:test:compile": "node bin/gpuix-svelte.js --bun test/compile.ts",
		"bun:test:css": "node bin/gpuix-svelte.js --bun test/css.ts",
		"bun:test:module": "node bin/gpuix-svelte.js --bun test/module.ts",
		"bun:test:lifecycle": "node bin/gpuix-svelte.js --bun test/lifecycle.ts",
		"bun:test:teardown": "node bin/gpuix-svelte.js --bun test/teardown.ts",
		"bun:test:overlay": "node bin/gpuix-svelte.js --bun test/overlay.ts",
		"bun:test:style": "node bin/gpuix-svelte.js --bun test/style.ts",
		"bun:test:props": "node bin/gpuix-svelte.js --bun test/props.ts",
