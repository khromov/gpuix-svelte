{
	"name": "gpuix-svelte",
	"version": "0.1.0",
	"description": "Svelte custom renderer for GPUI (Zed's GPU-accelerated UI framework), via @gpuix/native",
	"type": "module",
	"license": "MIT",
	"author": "Stanislav Khromov",
	"main": "src/index.js",
	"exports": {
		".": "./src/index.js",
		"./renderer": "./src/renderer.js",
		"./plugin": "./src/plugin.js",
		"./register": "./src/register.js",
		"./package.json": "./package.json"
	},
	"files": [
		"src"
	],
	"engines": {
		"node": ">=26.1.0",
		"bun": ">=1.4.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/khromov/gpuix-svelte"
	},
	"keywords": [
		"svelte",
		"gpui",
		"gpuix",
		"custom-renderer",
		"native",
		"gui",
		"node"
	],
	"scripts": {
		"demo": "node scripts/demo-all.js",
		"demo:counter": "node --conditions custom-renderer --conditions development --import ./src/register.js examples/counter/main.js",
		"demo:tictactoe": "node --conditions custom-renderer --conditions development --import ./src/register.js examples/tic-tac-toe/main.js",
		"demo:hn": "node --conditions custom-renderer --conditions development --import ./src/register.js examples/hacker-news/main.js",
		"demo:glass": "node --conditions custom-renderer --conditions development --import ./src/register.js examples/liquid-glass/main.js",
		"demo:glass-ffi": "node --experimental-ffi --conditions custom-renderer --conditions development --import ./src/register.js examples/liquid-glass-ffi/main.js",
		"demo:styling": "node --conditions custom-renderer --conditions development --import ./src/register.js examples/styling-playground/main.js",
		"test": "npm run test:reorder && npm run test:smoke && npm run test:autocommit && npm run test:style && npm run test:teardown && npm run test:lifecycle && npm run test:compile && npm run test:css",
		"test:reorder": "node --conditions custom-renderer --conditions development --import ./src/register.js test/reorder.js",
		"test:smoke": "node --conditions custom-renderer --conditions development --import ./src/register.js test/smoke.js",
		"test:autocommit": "node --conditions custom-renderer --conditions development --import ./src/register.js test/autocommit.js",
		"test:compile": "node --conditions custom-renderer --conditions development --import ./src/register.js test/compile.js",
		"test:css": "node --conditions custom-renderer --conditions development --import ./src/register.js test/css.js",
		"test:lifecycle": "node --conditions custom-renderer --conditions development --import ./src/register.js test/lifecycle.js",
		"test:teardown": "node --conditions custom-renderer --conditions development --import ./src/register.js test/teardown.js",
		"test:style": "node --conditions custom-renderer --conditions development --import ./src/register.js test/style.js",
		"test:coverage": "node --conditions custom-renderer --conditions development --import ./src/register.js test/coverage.js",
		"vendor": "node scripts/vendor-svelte.js",
		"compile": "bun scripts/compile.js",
		"compile:app": "bun scripts/compile.js --app",
		"bun:demo": "node scripts/demo-all.js --bun",
		"bun:demo:counter": "bun --conditions custom-renderer --conditions development examples/counter/main.js",
		"bun:demo:tictactoe": "bun --conditions custom-renderer --conditions development examples/tic-tac-toe/main.js",
		"bun:demo:hn": "bun --conditions custom-renderer --conditions development examples/hacker-news/main.js",
		"bun:demo:glass": "bun --conditions custom-renderer --conditions development examples/liquid-glass/main.js",
		"bun:demo:glass-ffi": "bun --conditions custom-renderer --conditions development examples/liquid-glass-ffi/main.js",
		"bun:demo:styling": "bun --conditions custom-renderer --conditions development examples/styling-playground/main.js",
		"bun:test": "npm run bun:test:reorder && npm run bun:test:smoke && npm run bun:test:autocommit && npm run bun:test:style && npm run bun:test:teardown && npm run bun:test:lifecycle && npm run bun:test:compile && npm run bun:test:css",
		"bun:test:reorder": "bun --conditions custom-renderer --conditions development test/reorder.js",
		"bun:test:smoke": "bun --conditions custom-renderer --conditions development test/smoke.js",
		"bun:test:autocommit": "bun --conditions custom-renderer --conditions development test/autocommit.js",
		"bun:test:compile": "bun --conditions custom-renderer --conditions development test/compile.js",
		"bun:test:css": "bun --conditions custom-renderer --conditions development test/css.js",
		"bun:test:lifecycle": "bun --conditions custom-renderer --conditions development test/lifecycle.js",
		"bun:test:teardown": "bun --conditions custom-renderer --conditions development test/teardown.js",
		"bun:test:style": "bun --conditions custom-renderer --conditions development test/style.js",
		"bun:test:coverage": "bun --conditions custom-renderer --conditions development test/coverage.js"
	},
	"dependencies": {
		"@gpuix/native": ">=0.7.0 <=0.8.0",
		"acorn": "^8.18.0"
	},
	"peerDependencies": {
		"svelte": ">=5.56.0"
	},
	"devDependencies": {
		"svelte": "file:vendor/svelte-5.57.0-6be4ab9.tgz"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	}
}
